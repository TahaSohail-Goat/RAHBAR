FROM python:3.12.16-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /workspace
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends tesseract-ocr poppler-utils \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 10001 -m rahbar
COPY api/requirements.txt /tmp/api-requirements.txt
COPY requirements-audit.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --only-binary=:all: --require-hashes -r /tmp/requirements.lock
COPY api/app ./api/app
COPY indexer/pipeline ./indexer/pipeline
COPY eval ./eval
RUN mkdir -p /var/lib/rahbar && chown -R 10001:10001 /var/lib/rahbar
USER 10001:10001
ENTRYPOINT ["python", "-m", "eval.assignment3.runner"]
